{
  "schemaVersion": 1,
  "id": "book-enchanter",
  "version": "${version}",
  "name": "Book Enchanter",
  "description": "Meteor Client addon that automatically enchants books at the enchanting table until a chosen target enchantment is offered.",
  "authors": [
    "Tore"
  ],
  "contact": {
    "sources": "https://github.com/Tore/book-enchanter"
  },
  "icon": "assets/book-enchanter/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "de.tore.bookenchanter.BookEnchanterAddon"
    ]
  },
  "custom": {
    "meteor-client:color": "225,25,25",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*"
  }
}
